# ============================================================
# Market Intelligence Hub — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Data Sources ---
COINGECKO_API_KEY=your_coingecko_api_key_here
YFINANCE_API_KEY=your_yfinance_api_key_here
NEWSAPI_KEY=your_newsapi_key_here
GLASSNODE_API_KEY=your_glassnode_api_key_here

# --- PostgreSQL (OLTP) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=market_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/market_intelligence

# --- Apache Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_MARKET_EVENTS=market-events
KAFKA_TOPIC_NEWS_EVENTS=news-events
KAFKA_CONSUMER_GROUP_ID=market-intelligence-consumer

# --- Google Cloud Platform ---
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=us-central1
GCS_BUCKET_NAME=market-intelligence-raw
BIGQUERY_DATASET=market_intelligence_dw
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Apache Airflow ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:your_postgres_password_here@localhost:5432/airflow
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__SECRET_KEY=your_webserver_secret_key_here

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your_api_secret_key_here
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Grafana / Prometheus ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here
PROMETHEUS_PORT=9090

# --- dbt ---
DBT_PROFILES_DIR=./infra/dbt
DBT_TARGET=dev

# --- Logging ---
LOG_LEVEL=INFO
